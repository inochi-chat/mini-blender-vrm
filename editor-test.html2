<!doctype html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<meta name="viewport"
  content="width=device-width, initial-scale=1,
  maximum-scale=1, user-scalable=no">
<meta name="theme-color" content="#171923">
<title>Mini Blender VRM</title>

<style>
:root {
  color-scheme: dark;
  --bg: #171923;
  --panel: #222533;
  --panel2: #2b3042;
  --text: #f4f5fb;
  --muted: #b8bfd1;
  --accent: #7c9cff;
  --border: #41485d;
  --danger: #b84354;
}

* {
  box-sizing: border-box;
  -webkit-tap-highlight-color: transparent;
}

html, body {
  margin: 0;
  width: 100%;
  height: 100%;
  overflow: hidden;
  background: var(--bg);
  color: var(--text);
  font-family: -apple-system, BlinkMacSystemFont,
    "Segoe UI", sans-serif;
}

button, input {
  font: inherit;
}

button {
  min-height: 42px;
  padding: 9px 10px;
  border: 1px solid var(--border);
  border-radius: 10px;
  background: var(--panel2);
  color: var(--text);
  cursor: pointer;
  touch-action: manipulation;
}

button:active {
  filter: brightness(1.25);
}

button:disabled {
  opacity: .38;
  cursor: default;
}

button.active {
  background: var(--accent);
  color: #101426;
  border-color: var(--accent);
  font-weight: 700;
}

button.danger {
  background: #592b38;
  border-color: #87404e;
}

button.primary {
  background: #344b87;
  border-color: #617fce;
}

#app {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
}

header {
  flex: 0 0 auto;
  padding: 10px 12px;
  background: #202332;
  border-bottom: 1px solid var(--border);
  z-index: 5;
}

.header-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
}

h1 {
  font-size: 17px;
  margin: 0;
}

#status {
  margin-top: 6px;
  font-size: 12px;
  color: #b8d0ff;
  min-height: 17px;
}

#workspace {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
}

#viewport {
  position: relative;
  flex: 1 1 48%;
  min-height: 180px;
  overflow: hidden;
  background:
    radial-gradient(circle at 50% 35%,
      #30364b 0%, #1b1e2b 75%);
  touch-action: none;
}

#viewport canvas {
  display: block;
  width: 100%;
  height: 100%;
  touch-action: none;
}

#viewHint {
  position: absolute;
  left: 8px;
  bottom: 8px;
  pointer-events: none;
  color: #d1d7e8;
  background: #121522b8;
  padding: 5px 8px;
  border-radius: 7px;
  font-size: 11px;
}

#panel {
  flex: 0 0 auto;
  height: 49%;
  min-height: 200px;
  overflow-y: auto;
  overscroll-behavior: contain;
  padding: 10px;
  padding-bottom: max(18px, env(safe-area-inset-bottom));
  background: var(--bg);
  border-top: 1px solid var(--border);
  -webkit-overflow-scrolling: touch;
}

.section {
  padding: 10px;
  margin-bottom: 10px;
  border: 1px solid var(--border);
  border-radius: 12px;
  background: var(--panel);
}

.section-title {
  font-size: 14px;
  font-weight: 700;
  margin-bottom: 9px;
}

.row {
  display: flex;
  gap: 7px;
  margin-top: 7px;
  align-items: stretch;
}

.row > button {
  flex: 1 1 0;
  min-width: 0;
}

.grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 7px;
}

.small {
  margin-top: 7px;
  color: var(--muted);
  font-size: 12px;
  line-height: 1.5;
}

#objectList {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.object-item {
  display: flex;
  gap: 7px;
  align-items: center;
}

.object-item button {
  flex: 1;
  text-align: left;
  overflow-wrap: anywhere;
}

.object-item button.selected {
  border-color: var(--accent);
  background: #35456f;
}

.object-item .mini-delete {
  flex: 0 0 43px;
  text-align: center;
  padding: 7px;
}

input[type="color"] {
  width: 100%;
  height: 42px;
  border: 1px solid var(--border);
  border-radius: 9px;
  background: var(--panel2);
  padding: 3px;
}

input[type="file"] {
  display: none;
}

@media (orientation: landscape) {
  #workspace {
    flex-direction: row;
  }

  #viewport {
    flex: 1 1 62%;
    height: 100%;
    min-height: 0;
  }

  #panel {
    flex: 0 0 38%;
    height: 100%;
    min-height: 0;
    border-top: 0;
    border-left: 1px solid var(--border);
  }
}
</style>

<script type="importmap">
{
  "imports": {
    "three": "https://cdn.jsdelivr.net/npm/three@0.180.0/build/three.module.js",
    "three/addons/controls/OrbitControls.js": "https://cdn.jsdelivr.net/npm/three@0.180.0/examples/jsm/controls/OrbitControls.js"
  }
}
</script>
</head>

<body>
<div id="app">

  <header>
    <div class="header-row">
      <h1>Mini Blender VRM</h1>
      <button id="undoButton">↶ 元に戻す</button>
    </div>
    <div id="status">準備中...</div>
  </header>

  <main id="workspace">
    <div id="viewport">
      <div id="viewHint">
        ドラッグ：回転 ／ 2本指：ズーム・移動
      </div>
    </div>

    <div id="panel">

      <section class="section">
        <div class="section-title">① オブジェクト追加</div>
        <div class="row">
          <button id="addBox" class="primary">＋ 箱</button>
          <button id="addSphere" class="primary">＋ 球</button>
          <button id="addCylinder" class="primary">＋ 円柱</button>
        </div>
        <div class="small">
          追加した形状を選択して編集できるよ。
        </div>
      </section>

      <section class="section">
        <div class="section-title">② 編集モード</div>
        <div class="grid">
          <button data-mode="object">オブジェクト</button>
          <button data-mode="vertex">頂点</button>
          <button data-mode="edge">辺</button>
          <button data-mode="face" class="active">面</button>
        </div>
        <div class="small">
          頂点・辺・面モードでは、3D画面の対象をタップして選択するよ。
          面は三角形単位で選択されるよ。
        </div>
      </section>

      <section class="section">
        <div class="section-title">③ 選択部分を編集</div>
        <div class="row">
          <button id="moveXMinus">X −</button>
          <button id="moveXPlus">X ＋</button>
        </div>
        <div class="row">
          <button id="moveYMinus">Y −</button>
          <button id="moveYPlus">Y ＋</button>
        </div>
        <div class="row">
          <button id="moveZMinus">Z −</button>
          <button id="moveZPlus">Z ＋</button>
        </div>
        <div class="row">
          <button id="scaleDown">縮小</button>
          <button id="scaleUp">拡大</button>
        </div>
        <div class="small">
          オブジェクトモードではモデル全体を操作するよ。
          頂点・辺・面モードでは選択した部分を操作するよ。
        </div>
      </section>

      <section class="section">
        <div class="section-title">④ 面の加工</div>
        <div class="row">
          <button id="extrudeButton" class="primary">面を押し出す</button>
          <button id="subdivideButton">面を細分化</button>
        </div>
        <div class="small">
          面モードで三角形の面を選んでから使ってね。
        </div>
      </section>

      <section class="section">
        <div class="section-title">⑤ 色・削除</div>
        <div class="row">
          <input id="colorInput" type="color" value="#7c9cff"
            aria-label="オブジェクトの色">
          <button id="applyColor">色を適用</button>
          <button id="deleteObject" class="danger">削除</button>
        </div>
        <div class="row">
          <button id="resetTransform">変形をリセット</button>
          <button id="resetCamera">カメラをリセット</button>
        </div>
      </section>

      <section class="section">
        <div class="section-title">⑥ オブジェクト一覧</div>
        <div id="objectList"></div>
        <div class="small">
          一覧から選択したり、個別に削除したりできるよ。
        </div>
      </section>

      <section class="section">
        <div class="section-title">⑦ 参考イラスト</div>

        <input id="referenceImageInput"
          type="file" accept="image/*">

        <div class="row">
          <button id="loadReferenceImage" class="primary">
            写真から読み込む
          </button>
          <button id="toggleReferenceImage" disabled>
            画像を隠す
          </button>
        </div>

        <div class="row">
          <button id="removeReferenceImage"
            class="danger" disabled>
            画像を削除
          </button>
        </div>

        <div class="small">
          iPhoneの写真から参考イラストを読み込めるよ。
          非表示にしても画像は保持され、もう一度表示できるよ。
          削除は参考画像だけに作用するよ。
        </div>
      </section>

    </div>
  </main>
</div>

<script type="module">
import * as THREE from "three";
import { OrbitControls } from
  "three/addons/controls/OrbitControls.js";

/* =========================================
   基本設定
========================================= */

const viewport = document.getElementById("viewport");
const statusEl = document.getElementById("status");
const objectList = document.getElementById("objectList");

function say(message) {
  statusEl.textContent = message;
}

const scene = new THREE.Scene();
scene.background = new THREE.Color("#1b1e2b");

const camera = new THREE.PerspectiveCamera(
  45,
  1,
  0.1,
  1000
);
camera.position.set(5, 4, 7);

const renderer = new THREE.WebGLRenderer({
  antialias: true,
  alpha: false
});
renderer.setPixelRatio(
  Math.min(window.devicePixelRatio || 1, 2)
);
renderer.outputColorSpace = THREE.SRGBColorSpace;
renderer.domElement.style.width = "100%";
renderer.domElement.style.height = "100%";
viewport.prepend(renderer.domElement);

const controls = new OrbitControls(
  camera,
  renderer.domElement
);
controls.enableDamping = true;
controls.dampingFactor = 0.08;
controls.target.set(0, 1, 0);

scene.add(new THREE.HemisphereLight(
  0xffffff, 0x62647a, 2.0
));

const light = new THREE.DirectionalLight(0xffffff, 2.2);
light.position.set(5, 9, 7);
scene.add(light);

const grid = new THREE.GridHelper(
  20, 20, 0x77809b, 0x41485d
);
scene.add(grid);

const axes = new THREE.AxesHelper(2);
scene.add(axes);

const helperGroup = new THREE.Group();
scene.add(helperGroup);

let objects = [];
let selectedObject = null;
let mode = "face";
let selectedComponent = null;
let nextObjectNumber = 1;

/* =========================================
   参考画像
========================================= */

let referenceSprite = null;
let referenceTexture = null;
let referenceObjectURL = null;
let referenceVisible = true;
let imageLoadToken = 0;

const referenceInput =
  document.getElementById("referenceImageInput");
const loadReferenceButton =
  document.getElementById("loadReferenceImage");
const toggleReferenceButton =
  document.getElementById("toggleReferenceImage");
const removeReferenceButton =
  document.getElementById("removeReferenceImage");

loadReferenceButton.addEventListener("click", () => {
  referenceInput.click();
});

referenceInput.addEventListener("change", event => {
  const file = event.target.files?.[0];
  if (!file) return;

  if (!file.type.startsWith("image/")) {
    say("画像ファイルを選んでね。");
    referenceInput.value = "";
    return;
  }

  const token = ++imageLoadToken;

  if (referenceObjectURL) {
    URL.revokeObjectURL(referenceObjectURL);
    referenceObjectURL = null;
  }

  const newURL = URL.createObjectURL(file);
  referenceObjectURL = newURL;

  say("参考画像を読み込み中...");

  const loader = new THREE.TextureLoader();

  loader.load(
    newURL,
    texture => {
      if (token !== imageLoadToken) {
        texture.dispose();
        return;
      }

      // 古い画像だけを削除。3Dモデルには触れない。
      if (referenceSprite) {
        scene.remove(referenceSprite);
        referenceSprite.material.dispose();
        referenceSprite = null;
      }

      if (referenceTexture) {
        referenceTexture.dispose();
        referenceTexture = null;
      }

      referenceTexture = texture;
      referenceTexture.colorSpace = THREE.SRGBColorSpace;
      referenceTexture.needsUpdate = true;

      const image = texture.image;
      const aspect = image.width / image.height;
      const height = 3.2;
      const width = Math.max(
        0.1,
        Math.min(height * aspect, 8)
      );

      const material = new THREE.SpriteMaterial({
        map: texture,
        transparent: true,
        opacity: 0.72,
        depthTest: false,
        depthWrite: false,
        toneMapped: false
      });

      referenceSprite = new THREE.Sprite(material);
      referenceSprite.scale.set(width, height, 1);
      referenceSprite.position.set(0, 1.6, -1.5);
      referenceSprite.renderOrder = 999;
      referenceSprite.visible = true;

      scene.add(referenceSprite);

      referenceVisible = true;
      toggleReferenceButton.disabled = false;
      toggleReferenceButton.textContent = "画像を隠す";
      removeReferenceButton.disabled = false;

      say("参考画像を読み込んだよ。");
    },
    undefined,
    error => {
      if (token !== imageLoadToken) return;

      console.error("画像読み込みエラー:", error);

      if (referenceObjectURL === newURL) {
        URL.revokeObjectURL(newURL);
        referenceObjectURL = null;
      }

      say("画像を読み込めなかったよ。別の画像で試してね。");
    }
  );
});

toggleReferenceButton.addEventListener("click", () => {
  if (!referenceSprite) {
    say("表示する画像がないよ。");
    return;
  }

  referenceVisible = !referenceVisible;
  referenceSprite.visible = referenceVisible;

  toggleReferenceButton.textContent =
    referenceVisible ? "画像を隠す" : "画像を表示";

  say(referenceVisible
    ? "参考画像を表示したよ。"
    : "参考画像を隠したよ。");
});

removeReferenceButton.addEventListener("click", () => {
  // 読み込み途中の画像も無効にする。
  imageLoadToken++;

  if (referenceSprite) {
    scene.remove(referenceSprite);

    if (referenceSprite.material) {
      referenceSprite.material.map = null;
      referenceSprite.material.dispose();
    }

    referenceSprite = null;
  }

  if (referenceTexture) {
    referenceTexture.dispose();
    referenceTexture = null;
  }

  if (referenceObjectURL) {
    URL.revokeObjectURL(referenceObjectURL);
    referenceObjectURL = null;
  }

  referenceInput.value = "";
  referenceVisible = true;

  toggleReferenceButton.disabled = true;
  removeReferenceButton.disabled = true;
  toggleReferenceButton.textContent = "画像を隠す";

  say("参考画像を削除したよ。3Dモデルはそのままだよ。");
});

/* =========================================
   ジオメトリ補助
========================================= */

function editableGeometry(geometry) {
  let result = geometry;

  if (result.index) {
    result = result.toNonIndexed();
    geometry.dispose();
  }

  result.computeVertexNormals();
  result.computeBoundingBox();
  result.computeBoundingSphere();

  return result;
}

function geometryTriangles(geometry) {
  const position = geometry.getAttribute("position");
  const result = [];

  for (let i = 0; i + 2 < position.count; i += 3) {
    result.push([
      new THREE.Vector3().fromBufferAttribute(position, i),
      new THREE.Vector3().fromBufferAttribute(position, i + 1),
      new THREE.Vector3().fromBufferAttribute(position, i + 2)
    ]);
  }

  return result;
}

function trianglesToGeometry(triangles) {
  const values = [];

  for (const triangle of triangles) {
    for (const point of triangle) {
      values.push(point.x, point.y, point.z);
    }
  }

  const geometry = new THREE.BufferGeometry();

  geometry.setAttribute(
    "position",
    new THREE.Float32BufferAttribute(values, 3)
  );

  geometry.computeVertexNormals();
  geometry.computeBoundingBox();
  geometry.computeBoundingSphere();

  return geometry;
}

function replaceGeometry(mesh, newGeometry) {
  const oldGeometry = mesh.geometry;
  mesh.geometry = newGeometry;
  oldGeometry.dispose();
}

/* =========================================
   Undo
========================================= */

const history = [];
const MAX_HISTORY = 20;

function snapshotState() {
  return {
    objects: objects.map(mesh => ({
      name: mesh.name,
      geometry: mesh.geometry.clone(),
      position: mesh.position.clone(),
      rotation: mesh.rotation.clone(),
      scale: mesh.scale.clone(),
      color: mesh.material.color.getHex(),
      selected: mesh === selectedObject
    })),
    nextObjectNumber
  };
}

function disposeSnapshot(snapshot) {
  for (const item of snapshot.objects) {
    item.geometry.dispose();
  }
}

function saveHistory() {
  history.push(snapshotState());

  while (history.length > MAX_HISTORY) {
    const old = history.shift();
    disposeSnapshot(old);
  }

  document.getElementById("undoButton").disabled =
    history.length === 0;
}

function undo() {
  if (!history.length) {
    say("元に戻せる操作がないよ。");
    return;
  }

  const snapshot = history.pop();

  for (const mesh of objects) {
    scene.remove(mesh);
    mesh.geometry.dispose();
    mesh.material.dispose();
  }

  objects = [];
  selectedObject = null;
  selectedComponent = null;

  for (const item of snapshot.objects) {
    const material = new THREE.MeshStandardMaterial({
      color: item.color,
      roughness: 0.72,
      metalness: 0.02,
      side: THREE.DoubleSide
    });

    const mesh = new THREE.Mesh(
      item.geometry,
      material
    );

    mesh.name = item.name;
    mesh.position.copy(item.position);
    mesh.rotation.copy(item.rotation);
    mesh.scale.copy(item.scale);

    objects.push(mesh);
    scene.add(mesh);

    if (item.selected) {
      selectedObject = mesh;
    }
  }

  nextObjectNumber = snapshot.nextObjectNumber;

  clearHelpers();
  updateObjectList();
  updateHelpers();

  document.getElementById("undoButton").disabled =
    history.length === 0;

  say("1つ前の状態に戻したよ。");
  disposeSnapshot(snapshot);
}

document.getElementById("undoButton")
  .addEventListener("click", undo);

/* =========================================
   オブジェクト追加・選択
========================================= */

function addObject(type) {
  saveHistory();

  let geometry;
  let label;

  if (type === "box") {
    geometry = new THREE.BoxGeometry(1.5, 1.5, 1.5);
    label = "箱";
  } else if (type === "sphere") {
    geometry = new THREE.SphereGeometry(0.85, 16, 12);
    label = "球";
  } else {
    geometry = new THREE.CylinderGeometry(
      0.65, 0.65, 1.6, 16
    );
    label = "円柱";
  }

  geometry = editableGeometry(geometry);

  const material = new THREE.MeshStandardMaterial({
    color: document.getElementById("colorInput").value,
    roughness: 0.72,
    metalness: 0.02,
    side: THREE.DoubleSide
  });

  const mesh = new THREE.Mesh(geometry, material);

  mesh.name = label + " " + nextObjectNumber++;
  mesh.position.set(
    (objects.length % 3) * 1.8,
    0.8,
    Math.floor(objects.length / 3) * 1.8
  );

  objects.push(mesh);
  scene.add(mesh);

  selectedObject = mesh;
  selectedComponent = null;

  updateObjectList();
  updateHelpers();

  say(mesh.name + "を追加したよ。");
}

document.getElementById("addBox")
  .addEventListener("click", () => addObject("box"));

document.getElementById("addSphere")
  .addEventListener("click", () => addObject("sphere"));

document.getElementById("addCylinder")
  .addEventListener("click", () => addObject("cylinder"));

function selectObject(mesh) {
  if (!mesh || !objects.includes(mesh)) return;

  selectedObject = mesh;
  selectedComponent = null;

  updateObjectList();
  updateHelpers();

  say(mesh.name + "を選択したよ。");
}

function updateObjectList() {
  objectList.replaceChildren();

  for (const mesh of objects) {
    const row = document.createElement("div");
    row.className = "object-item";

    const selectButton = document.createElement("button");
    selectButton.textContent = mesh.name;

    if (mesh === selectedObject) {
      selectButton.classList.add("selected");
    }

    selectButton.addEventListener("click", () => {
      selectObject(mesh);
    });

    const deleteButton = document.createElement("button");
    deleteButton.className = "mini-delete danger";
    deleteButton.textContent = "削除";
    deleteButton.setAttribute(
      "aria-label", mesh.name + "を削除"
    );

    deleteButton.addEventListener("click", () => {
      if (mesh === selectedObject) {
        deleteSelectedObject();
      } else {
        saveHistory();

        scene.remove(mesh);
        mesh.geometry.dispose();
        mesh.material.dispose();

        objects = objects.filter(item => item !== mesh);

        updateObjectList();
        say(mesh.name + "を削除したよ。");
      }
    });

    row.append(selectButton, deleteButton);
    objectList.append(row);
  }
}

/* =========================================
   モード切り替え
========================================= */

function setMode(newMode) {
  mode = newMode;
  selectedComponent = null;

  document.querySelectorAll("[data-mode]").forEach(button => {
    button.classList.toggle(
      "active",
      button.dataset.mode === mode
    );
  });

  updateHelpers();
  say("編集モード：" + {
    object: "オブジェクト",
    vertex: "頂点",
    edge: "辺",
    face: "面"
  }[mode]);
}

document.querySelectorAll("[data-mode]").forEach(button => {
  button.addEventListener("click", () => {
    setMode(button.dataset.mode);
  });
});

/* =========================================
   選択表示
========================================= */

function clearHelpers() {
  while (helperGroup.children.length) {
    const child = helperGroup.children[0];
    helperGroup.remove(child);

    if (child.geometry) child.geometry.dispose();

    if (child.material) {
      if (Array.isArray(child.material)) {
        child.material.forEach(material => material.dispose());
      } else {
        child.material.dispose();
      }
    }
  }
}

function addLine(points, color = 0xffd54a) {
  const geometry = new THREE.BufferGeometry()
    .setFromPoints(points);

  const material = new THREE.LineBasicMaterial({
    color,
    depthTest: false,
    transparent: true
  });

  const line = new THREE.Line(geometry, material);
  line.renderOrder = 1001;
  helperGroup.add(line);
}

function addVertexMarker(worldPosition) {
  const geometry = new THREE.SphereGeometry(0.065, 10, 8);
  const material = new THREE.MeshBasicMaterial({
    color: 0xffd54a,
    depthTest: false
  });

  const marker = new THREE.Mesh(geometry, material);
  marker.position.copy(worldPosition);
  marker.renderOrder = 1002;
  helperGroup.add(marker);
}

function updateHelpers() {
  clearHelpers();

  if (!selectedObject) return;

  if (mode === "object") {
    const box = new THREE.BoxHelper(
      selectedObject, 0xffd54a
    );
    box.renderOrder = 1000;
    helperGroup.add(box);
    return;
  }

  if (!selectedComponent) return;

  const points = selectedComponent.points.map(point => {
    return selectedObject.localToWorld(point.clone());
  });

  if (mode === "vertex") {
    addVertexMarker(points[0]);
  } else if (mode === "edge") {
    addLine(points, 0xffd54a);
    points.forEach(addVertexMarker);
  } else if (mode === "face") {
    addLine([
      points[0], points[1],
      points[1], points[2],
      points[2], points[0]
    ], 0xffd54a);
    points.forEach(addVertexMarker);
  }
}

/* =========================================
   3D画面での選択
========================================= */

const raycaster = new THREE.Raycaster();
const pointer = new THREE.Vector2();

renderer.domElement.addEventListener("click", event => {
  const rect = renderer.domElement.getBoundingClientRect();

  pointer.x = (
    (event.clientX - rect.left) / rect.width
  ) * 2 - 1;

  pointer.y = -(
    (event.clientY - rect.top) / rect.height
  ) * 2 + 1;

  raycaster.setFromCamera(pointer, camera);

  const hits = raycaster.intersectObjects(objects, false);

  if (!hits.length) return;

  const hit = hits[0];

  if (mode === "object") {
    selectObject(hit.object);
    return;
  }

  if (!hit.face) return;

  if (hit.object !== selectedObject) {
    selectedObject = hit.object;
    selectedComponent = null;
    updateObjectList();
  }

  const mesh = hit.object;
  const position = mesh.geometry.getAttribute("position");
  const faceIndex = hit.faceIndex;

  if (faceIndex == null) return;

  const base = faceIndex * 3;

  if (base + 2 >= position.count) return;

  const a = new THREE.Vector3()
    .fromBufferAttribute(position, base);
  const b = new THREE.Vector3()
    .fromBufferAttribute(position, base + 1);
  const c = new THREE.Vector3()
    .fromBufferAttribute(position, base + 2);

  if (mode === "face") {
    selectedComponent = {
      type: "face",
      faceIndex,
      points: [a, b, c].map(p => p.clone())
    };
  } else if (mode === "vertex") {
    const candidates = [a, b, c];

    let closest = candidates[0];
    let distance = Infinity;

    for (const point of candidates) {
      const world = mesh.localToWorld(point.clone());
      const d = world.distanceTo(hit.point);

      if (d < distance) {
        distance = d;
        closest = point;
      }
    }

    selectedComponent = {
      type: "vertex",
      points: [closest.clone()]
    };
  } else if (mode === "edge") {
    const edges = [[a, b], [b, c], [c, a]];

    let bestEdge = edges[0];
    let bestDistance = Infinity;

    for (const edge of edges) {
      const worldA = mesh.localToWorld(edge[0].clone());
      const worldB = mesh.localToWorld(edge[1].clone());

      const line = new THREE.Line3(worldA, worldB);
      const closest = line.closestPointToPoint(
        hit.point, true, new THREE.Vector3()
      );

      const d = closest.distanceTo(hit.point);

      if (d < bestDistance) {
        bestDistance = d;
        bestEdge = edge;
      }
    }

    selectedComponent = {
      type: "edge",
      points: bestEdge.map(p => p.clone())
    };
  }

  updateHelpers();

  say({
    vertex: "頂点を選択したよ。",
    edge: "辺を選択したよ。",
    face: "面を選択したよ。"
  }[mode] || "選択したよ。");
});

/* =========================================
   選択部分の変形
========================================= */

function samePoint(a, b, epsilon = 0.0001) {
  return a.distanceToSquared(b) < epsilon * epsilon;
}

function moveSelection(axis, amount) {
  if (!selectedObject) {
    say("先にオブジェクトを追加してね。");
    return;
  }

  saveHistory();

  if (mode === "object" || !selectedComponent) {
    selectedObject.position[axis] += amount;
  } else {
    const geometry = selectedObject.geometry;
    const position = geometry.getAttribute("position");
    const targets = selectedComponent.points;

    for (let i = 0; i < position.count; i++) {
      const point = new THREE.Vector3()
        .fromBufferAttribute(position, i);

      if (targets.some(target => samePoint(point, target))) {
        point[axis] += amount;
        position.setXYZ(i, point.x, point.y, point.z);
      }
    }

    position.needsUpdate = true;
    geometry.computeVertexNormals();
    geometry.computeBoundingBox();
    geometry.computeBoundingSphere();

    // 選択点も移動させ、連続操作しやすくする。
    for (const point of selectedComponent.points) {
      point[axis] += amount;
    }
  }

  updateHelpers();
  say("選択部分を移動したよ。");
}

function scaleSelection(factor) {
  if (!selectedObject) {
    say("先にオブジェクトを追加してね。");
    return;
  }

  saveHistory();

  if (mode === "object" || !selectedComponent) {
    selectedObject.scale.multiplyScalar(factor);
  } else {
    const geometry = selectedObject.geometry;
    const position = geometry.getAttribute("position");
    const targets = selectedComponent.points;

    const center = new THREE.Vector3();

    targets.forEach(point => center.add(point));
    center.divideScalar(targets.length);

    for (let i = 0; i < position.count; i++) {
      const point = new THREE.Vector3()
        .fromBufferAttribute(position, i);

      if (targets.some(target => samePoint(point, target))) {
        point.sub(center).multiplyScalar(factor).add(center);

        position.setXYZ(i, point.x, point.y, point.z);
      }
    }

    position.needsUpdate = true;
    geometry.computeVertexNormals();
    geometry.computeBoundingBox();
    geometry.computeBoundingSphere();

    selectedComponent.points = targets.map(point =>
      point.sub(center).multiplyScalar(factor).add(center)
    );
  }

  updateHelpers();
  say(factor > 1 ? "拡大したよ。" : "縮小したよ。");
}

document.getElementById("moveXMinus")
  .addEventListener("click", () => moveSelection("x", -0.2));
document.getElementById("moveXPlus")
  .addEventListener("click", () => moveSelection("x", 0.2));
document.getElementById("moveYMinus")
  .addEventListener("click", () => moveSelection("y", -0.2));
document.getElementById("moveYPlus")
  .addEventListener("click", () => moveSelection("y", 0.2));
document.getElementById("moveZMinus")
  .addEventListener("click", () => moveSelection("z", -0.2));
document.getElementById("moveZPlus")
  .addEventListener("click", () => moveSelection("z", 0.2));

document.getElementById("scaleDown")
  .addEventListener("click", () => scaleSelection(0.9));
document.getElementById("scaleUp")
  .addEventListener("click", () => scaleSelection(1.1));

/* =========================================
   面の押し出し・細分化
========================================= */

function requireFace() {
  if (
    !selectedObject ||
    mode !== "face" ||
    !selectedComponent ||
    selectedComponent.type !== "face"
  ) {
    say("面モードにして、3D画面の面を選んでね。");
    return false;
  }

  return true;
}

document.getElementById("extrudeButton")
  .addEventListener("click", () => {
    if (!requireFace()) return;

    const mesh = selectedObject;
    const faceIndex = selectedComponent.faceIndex;
    const triangles = geometryTriangles(mesh.geometry);

    if (!triangles[faceIndex]) {
      say("面を選び直してね。");
      return;
    }

    saveHistory();

    const face = triangles[faceIndex];
    const [a, b, c] = face.map(p => p.clone());

    const normal = new THREE.Vector3()
      .subVectors(b, a)
      .cross(new THREE.Vector3().subVectors(c, a))
      .normalize();

    const distance = 0.5;

    const a2 = a.clone().addScaledVector(normal, distance);
    const b2 = b.clone().addScaledVector(normal, distance);
    const c2 = c.clone().addScaledVector(normal, distance);

    const result = [];

    for (let i = 0; i < triangles.length; i++) {
      if (i !== faceIndex) {
        result.push(triangles[i]);
      }
    }

    // 押し出した先端の三角形
    const newFaceIndex = result.length;
    result.push([a2, b2, c2]);

    // 側面を構成する6枚の三角形
    result.push([a, b, b2], [a, b2, a2]);
    result.push([b, c, c2], [b, c2, b2]);
    result.push([c, a, a2], [c, a2, c2]);

    replaceGeometry(mesh, trianglesToGeometry(result));

    selectedComponent = {
      type: "face",
      faceIndex: newFaceIndex,
      points: [a2, b2, c2]
    };

    updateHelpers();
    say("面を押し出したよ。");
  });

document.getElementById("subdivideButton")
  .addEventListener("click", () => {
    if (!requireFace()) return;

    const mesh = selectedObject;
    const faceIndex = selectedComponent.faceIndex;
    const triangles = geometryTriangles(mesh.geometry);

    if (!triangles[faceIndex]) {
      say("面を選び直してね。");
      return;
    }

    saveHistory();

    const [a, b, c] = triangles[faceIndex]
      .map(p => p.clone());

    const ab = a.clone().add(b).multiplyScalar(0.5);
    const bc = b.clone().add(c).multiplyScalar(0.5);
    const ca = c.clone().add(a).multiplyScalar(0.5);

    const result = [];

    for (let i = 0; i < triangles.length; i++) {
      if (i !== faceIndex) {
        result.push(triangles[i]);
      }
    }

    const newFaceIndex = result.length;

    result.push(
      [a, ab, ca],
      [ab, b, bc],
      [ca, bc, c],
      [ab, bc, ca]
    );

    replaceGeometry(mesh, trianglesToGeometry(result));

    selectedComponent = {
      type: "face",
      faceIndex: newFaceIndex,
      points: [a, ab, ca]
    };

    updateHelpers();
    say("選択した面を4つに細分化したよ。");
  });

/* =========================================
   色・削除・リセット
========================================= */

document.getElementById("applyColor")
  .addEventListener("click", () => {
    if (!selectedObject) {
      say("色を変更するオブジェクトを選んでね。");
      return;
    }

    saveHistory();

    selectedObject.material.color.set(
      document.getElementById("colorInput").value
    );

    say("色を変更したよ。");
  });

function deleteSelectedObject() {
  if (!selectedObject) {
    say("削除するオブジェクトを選んでね。");
    return;
  }

  saveHistory();

  const removed = selectedObject;

  scene.remove(removed);
  removed.geometry.dispose();
  removed.material.dispose();

  objects = objects.filter(mesh => mesh !== removed);
  selectedObject = null;
  selectedComponent = null;

  clearHelpers();
  updateObjectList();

  say("オブジェクトを削除したよ。");
}

document.getElementById("deleteObject")
  .addEventListener("click", deleteSelectedObject);

document.getElementById("resetTransform")
  .addEventListener("click", () => {
    if (!selectedObject) {
      say("先にオブジェクトを選んでね。");
      return;
    }

    saveHistory();

    selectedObject.position.set(0, 0.8, 0);
    selectedObject.rotation.set(0, 0, 0);
    selectedObject.scale.set(1, 1, 1);

    updateHelpers();
    say("オブジェクトの変形をリセットしたよ。");
  });

function resetCamera() {
  camera.position.set(5, 4, 7);
  controls.target.set(0, 1, 0);
  controls.update();

  say("カメラをリセットしたよ。");
}

document.getElementById("resetCamera")
  .addEventListener("click", resetCamera);

/* =========================================
   画面サイズ調整・描画
========================================= */

function resize() {
  const width = Math.max(1, viewport.clientWidth);
  const height = Math.max(1, viewport.clientHeight);

  camera.aspect = width / height;
  camera.updateProjectionMatrix();

  renderer.setSize(width, height, false);
}

if ("ResizeObserver" in window) {
  const resizeObserver = new ResizeObserver(resize);
  resizeObserver.observe(viewport);
} else {
  window.addEventListener("resize", resize);
}

function animate() {
  requestAnimationFrame(animate);

  controls.update();

  for (const child of helperGroup.children) {
    if (child.isBoxHelper) child.update();
  }

  renderer.render(scene, camera);
}

resize();

// 最初の箱
addObject("box");
setMode("face");

history.length = 0;
document.getElementById("undoButton").disabled = true;

animate();
say("準備完了！ 箱を編集したり、参考画像を読み込んだりできるよ。");
</script>
</body>
</html>
